# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요.  (Windows: copy .env.example .env)
# .env 는 git 에 올라가지 않습니다. API 키는 절대 커밋하지 마세요.

# PostgreSQL (docker compose 로 띄운 DB)
DATABASE_URL=postgresql+psycopg://nova:nova@localhost:5432/nova
# 내 PC 에 이미 PostgreSQL 이 5432 를 쓰고 있으면 아래 포트를 바꾸고, 위 주소의 5432 도 같이 바꾸세요.
DB_PORT=5432

# 프론트 개발 서버 주소 (여러 개면 쉼표로 구분)
CORS_ORIGINS=http://localhost:5173

# OpenAI — 비워두면 "목업 AI" 로 동작합니다 (서버·적재·검색 흐름은 그대로 테스트 가능)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# RAG 검색 설정
RAG_TOP_K=5
# 이 점수(코사인 유사도)보다 낮으면 근거 부족으로 보고 "담당자 확인 필요" 로 안내
RAG_MIN_SCORE=0.3
