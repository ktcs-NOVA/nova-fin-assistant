# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요.  (Windows: copy .env.example .env)
# .env 는 git 에 올라가지 않습니다. API 키는 절대 커밋하지 마세요.

# PostgreSQL (docker compose 로 띄운 DB)
DATABASE_URL=postgresql+psycopg://nova:nova@localhost:5432/nova
# 내 PC 에 이미 PostgreSQL 이 5432 를 쓰고 있으면 아래 포트를 바꾸고, 위 주소의 5432 도 같이 바꾸세요.
DB_PORT=5432

# 프론트 개발 서버 주소 (여러 개면 쉼표로 구분)
CORS_ORIGINS=http://localhost:5173

# OpenAI — 비워두면 "목업 AI" 로 동작합니다 (서버·적재·검색 흐름은 그대로 테스트 가능)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
RECEIPT_MODEL=gpt-4o-mini   # 영수증 사진 판독 (gpt-4o 로 바꿀 수 있음, 11장 기준 정답률 동일)
EMBEDDING_MODEL=text-embedding-3-small

# RAG 검색 설정
RAG_TOP_K=5
# 이 점수(코사인 유사도)보다 낮으면 근거 부족으로 보고 "담당자 확인 필요" 로 안내
RAG_MIN_SCORE=0.3

# 경로 조회 (출장비 계산의 근무지 → 도착지 거리) — 네이버 클라우드 플랫폼 Maps
# 콘솔 > AI·Application Service > Maps > Application 등록 → Geocoding, Directions 5 선택 → 인증 정보
# 비워두면 화면에서 "거리를 직접 입력해 주세요"로 안내합니다.
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
# 예전 AI·NAVER API 상품으로 받은 키라면 주소를 아래로 바꾸세요
# NAVER_MAPS_BASE=https://naveropenapi.apigw.ntruss.com
# (선택) 장소 이름("부산시청")으로도 찾으려면: 네이버 클라우드 콘솔 > NAVER API HUB > Subscription 이용 신청
# > Application 등록(지역 검색 선택) > 인증 정보의 Client ID / Secret. Maps 키와 별개입니다.
# (예전 네이버 개발자센터 검색 API 는 API HUB 로 옮겨져 개발자센터에서는 발급되지 않습니다)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# 출발지(근무지). 기본값은 한국해양진흥공사 본사
# ROUTE_ORIGIN_ADDRESS=부산광역시 해운대구 마린시티2로 38
