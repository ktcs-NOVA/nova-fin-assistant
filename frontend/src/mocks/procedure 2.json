{
  "task": "국내 출장비 정산",
  "summary": "(예시) 출장보고서와 정산 출장원을 작성하고 교통비·숙박비 증빙을 붙여, 출장을 마친 날부터 15일 안에 정산을 신청합니다.",
  "documents": [
    { "name": "출장원(정산)", "detail": "별지 제3호 서식", "basis": "여비규정 별지 제3호 서식" },
    { "name": "출장보고서", "detail": "별지 제4호 서식", "basis": "여비규정 별지 제4호 서식" },
    { "name": "교통비·숙박비 영수증", "detail": "신용카드영수증 원칙. 청구서 발행이 어려우면 영수증만 제출 가능", "basis": "여비규정 제10조" },
    { "name": "숙박시설 발행 청구서", "detail": "상호·투숙자·호실·투숙기간·요금 내역이 보여야 함", "basis": "여비규정 제11조 제2항" }
  ],
  "steps": [
    { "title": "출장보고서·출장원(정산) 작성", "detail": "출장 내용과 여비를 정확히 계산해 적습니다.", "basis": "여비규정 제3조의2 제3항" },
    { "title": "증빙 첨부", "detail": "교통비·숙박비 영수증과 숙박시설 청구서를 붙입니다. 조식 포함 숙박이면 식비 1/3을 차감합니다.", "basis": "여비규정 제10조, 제11조" },
    { "title": "출장결과보고 승인", "detail": "출장승인권자가 금액과 증빙서류를 확인하고 승인합니다.", "basis": "여비규정 제3조의2 제3항" },
    { "title": "정산 신청", "detail": "승인된 내용으로 여비 정산을 신청합니다.", "basis": "여비규정 제3조의2 제2항" }
