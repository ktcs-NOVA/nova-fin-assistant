# 운영 서버용 설정. 서버에서 이 파일을 복사해 .env.prod 로 만든 뒤 값을 채우세요.
#   cp .env.prod.example .env.prod
# .env.prod 는 git 에 올라가지 않습니다. 키·비밀번호는 절대 커밋하지 마세요.

# 웹 포트 (보통 80). HTTPS 는 443
WEB_PORT=80

# HTTPS 를 쓸 도메인 — 비워 두면 http://서버IP 로만 동작
#   무료: 서버 IP 의 점을 - 로 바꿔 sslip.io 를 붙이면 됨 (예: 141.164.1.2 → 141-164-1-2.sslip.io)
#   넣기 전에 방화벽에서 443 을 열어 두세요. 넣은 뒤 CORS_ORIGINS 도 https://도메인 으로
SITE_ADDRESS=

# DB 비밀번호 — 영문·숫자로 길게 (특수문자는 주소에 들어가므로 피하기)
POSTGRES_PASSWORD=

# 로그인 토큰 서명 값 — 아무도 모르는 긴 문자열로 바꾸기
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# 접속 주소 (같은 주소에서 /api 로 부르므로 보통 필요 없지만 적어 둡니다)
CORS_ORIGINS=http://localhost

# OpenAI — 비워두면 목업 AI 로 동작
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
RECEIPT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 네이버 지도 (경로 거리 계산) — 비워두면 경로 기능만 꺼짐
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
